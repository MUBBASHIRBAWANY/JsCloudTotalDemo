{
  "expo": {
    "name": "Jaffar Son's International",
    "slug": "JSERP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jserp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#312E81",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#312E81"
    },
    "ios": {
      "bundleIdentifier": "com.jaffarsons.jserp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow JSERP to use your location for attendance and sales orders."
      },
      "icon": "./assets/expo.icon",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#312E81"
      }
    },
    "android": {
      "package": "com.jaffarsons.jserp",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E8E4F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#312E81"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#312E81",
      "barStyle": "light-content"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#312E81"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#312E81",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#312E81",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "imageWidth": 220
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JSERP to use the camera for attendance and order photos.",
          "photosPermission": "Allow JSERP to access photos for attendance and sales orders.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JSERP to use the camera for attendance and order photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JSERP to use your location for attendance and sales orders."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a76b83bc-6de2-43c3-80e6-404f4ed0bc06"
      }
    },
    "owner": "bawanymubbashir"
  }
}
